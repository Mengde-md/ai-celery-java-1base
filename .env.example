# Copy to .env for Docker Compose. Export application variables before starting Java.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_ACCESS_CODE=replace-with-a-long-random-access-code
TASK_CONCURRENCY=4

DB_URL="jdbc:mysql://127.0.0.1:3306/aicelery?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
DB_USERNAME=aicelery
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
FLYWAY_TABLE=aicelery_schema_history

DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENAI_ENABLED=false
OPENAI_API_KEY=
